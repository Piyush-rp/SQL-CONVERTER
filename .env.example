# Used by docker-compose.yml. Copy to .env in the project root.

# --- Required ---------------------------------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Metadata DB password (Postgres container that stores Copilot's own
# users/connections/history) -------------------------------------------------
METADATA_DB_PASSWORD=change_me

# --- LLM providers (set at least one) ---------------------------------------
DEFAULT_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Query safety -------------------------------------------------------------
ALLOW_WRITE_QUERIES=false
