# Copy this file to .env and fill in real values. Never commit the real .env.

# --- App ---------------------------------------------------------------
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- Metadata DB (Copilot's own users/connections/history) ----------------
# Use Postgres in staging/prod; SQLite is fine for local dev only.
DATABASE_URL=sqlite:///./app_metadata.db
# DATABASE_URL=postgresql+psycopg2://copilot:copilot@localhost:5432/copilot_metadata

# --- Auth ----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=2880
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM provider (Groq - get a key at https://console.groq.com/keys) --------
DEFAULT_LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Query safety ----------------------------------------------------------
MAX_ROWS_RETURNED=1000
QUERY_TIMEOUT_SECONDS=15
ALLOW_WRITE_QUERIES=false
MAX_AGENT_RETRIES=2

# --- Schema search strategy for narrowing large schemas ------------------------
# "keyword" (default) - exact token overlap, zero setup cost.
# "vector" - TF-IDF + FAISS embedding search (app/vectorstore) - better
# recall on large schemas where the question's wording doesn't share exact
# tokens with a relevant table's name (e.g. "clients" vs a "customers" table).
SCHEMA_SEARCH_STRATEGY=keyword

# --- Agentic tool-calling generation (app/tools) -------------------------------
# When true, SQL generation binds schema-lookup/validate/exploratory-query
# tools to the model and runs a bounded tool-call loop instead of a
# single-shot prompt. Needs a tool-calling-capable Groq model (e.g.
# openai/gpt-oss-120b).
ENABLE_TOOL_CALLING=false
MAX_TOOL_CALL_ITERATIONS=5

# --- Multi-instance scaling (optional) -----------------------------------------
# Set this to run more than one backend replica behind a load balancer -
# the schema cache and rate limiter automatically switch to Redis-backed
# implementations when it's set. Leave blank for a single instance.
REDIS_URL=

# --- Secrets provider (optional) -----------------------------------------------
# "env" (default) - nothing more to configure, SECRET_KEY/API keys above are used directly.
# "vault" - fetches SECRET_KEY/GROQ_API_KEY from HashiCorp
# Vault's KV v2 engine instead (see docs/setup.md).
SECRETS_PROVIDER=env
VAULT_ADDR=
VAULT_TOKEN=
VAULT_MOUNT_POINT=secret
VAULT_SECRET_PATH=sqlcopilot

# --- CORS (comma-separated list is NOT supported - edit core/config.py's
# default list directly, or extend Settings to parse a comma-separated env var) --
# CORS_ORIGINS is set in code for now; see app/core/config.py

RATE_LIMIT_PER_MINUTE=60
